body { margin: 0px; font-family: "Merriweather Sans", "Helvetica Neue", Helvetica, Arial, sans-serif; line-height: 1.8; }

details, main { display: block; }

h1 { font-size: 2em; margin: 0.67em 0px; }

a { background-color: transparent; color: rgb(2, 94, 141); text-decoration: underline 0.0625rem; text-decoration-skip-ink: auto; text-underline-offset: 0.25rem; }

sub { font-size: 75%; line-height: 0; position: relative; vertical-align: baseline; bottom: -0.25em; }

img { border: 0px; max-width: 100%; height: auto; vertical-align: middle; }

button, input { font-family: inherit; font-size: 100%; line-height: 1.15; margin: 0px; overflow: visible; }

button { text-transform: none; }

[type="submit"], button { appearance: button; }

[type="search"] { appearance: textfield; outline-offset: -2px; }

summary { display: list-item; }

[hidden] { display: none; }

button { cursor: pointer; }

svg { width: 1rem; height: 1rem; }

.eds-c-header__brand img { max-width: 100%; }

@media only screen and (min-width: 768px) {
  .eds-c-header__brand img { max-width: 340px; }
}
